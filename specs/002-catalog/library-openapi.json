{
  "openapi": "3.1.1",
  "info": {
    "title": "Piratarr library inventory API",
    "version": "0.3.0",
    "description": "Manual inventory only; no file mutation or movie association. See ticket 03 for implementation state."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/library/scan": {
      "post": {
        "operationId": "scanLibraryFiles",
        "summary": "Scan the saved movie folder in place",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "name": "X-Piratarr-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Last successfully committed inventory snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/library/files": {
      "get": {
        "operationId": "listLibraryFiles",
        "summary": "List the saved movie-folder inventory",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "present",
                "missing"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Last successfully committed inventory snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/library/files/{id}/review": {
      "post": {
        "operationId": "reviewLibraryFile",
        "summary": "Associate, ignore or reopen an observed file",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-Piratarr-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "revision",
                      "action",
                      "movieId",
                      "confirmIdentity"
                    ],
                    "properties": {
                      "revision": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "action": {
                        "const": "associate",
                        "type": "string"
                      },
                      "movieId": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "confirmIdentity": {
                        "const": true,
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "revision",
                      "action"
                    ],
                    "properties": {
                      "revision": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "ignore",
                          "reopen"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Last successfully committed inventory snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryEntry"
                }
              }
            }
          },
          "404": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Sanitized error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "InventoryEntry": {
        "type": "object",
        "required": [
          "id",
          "relativePath",
          "size",
          "modifiedAt",
          "status",
          "firstSeenAt",
          "lastSeenAt",
          "revision",
          "reviewState",
          "movieId",
          "movieTitle",
          "verifiedAt",
          "suggestedTitle",
          "suggestedYear"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "relativePath": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "missing"
            ]
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "reviewState": {
            "type": "string",
            "enum": [
              "pending",
              "associated",
              "ignored"
            ]
          },
          "movieId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "movieTitle": {
            "type": "string"
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "suggestedTitle": {
            "type": "string"
          },
          "suggestedYear": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "ScanSummary": {
        "type": "object",
        "required": [
          "scannedAt",
          "filesPresent",
          "skippedEntries"
        ],
        "properties": {
          "scannedAt": {
            "type": "string",
            "format": "date-time"
          },
          "filesPresent": {
            "type": "integer"
          },
          "skippedEntries": {
            "type": "integer"
          }
        }
      },
      "InventorySnapshot": {
        "type": "object",
        "required": [
          "root",
          "items",
          "total",
          "limit",
          "offset",
          "scan"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InventoryEntry"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "scan": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ScanSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
