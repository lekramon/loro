    "/api/v1/metadata/images/{size}/{filename}": {
      "get": {
        "operationId": "getMetadataArtwork",
        "summary": "Serve observed TMDB artwork through a bounded private local cache",
        "parameters": [
          {
            "name": "size",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "w342",
                "w780"
              ]
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+\\.(jpg|png)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified image bytes; cached files can be served offline.",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Artwork error.",
            "content": {
