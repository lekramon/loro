{
  "openapi": "3.1.1",
  "info": {
    "title": "Louro source and release search API",
    "version": "0.4.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/source": {
      "get": {
        "operationId": "getSourceConfiguration",
        "summary": "Read public source configuration",
        "responses": {
          "200": {
            "description": "Public configuration. Key omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveSourceConfiguration",
        "summary": "Save source and write-only key",
        "parameters": [
          {
            "name": "X-Piratarr-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "name",
                  "url"
                ],
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "apiKey": {
                    "type": "string",
                    "writeOnly": true,
                    "maxLength": 1024
                  },
                  "clearApiKey": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Public configuration. Key omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Source"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/source/test": {
      "get": {
        "operationId": "testSourceCapabilities",
        "summary": "Fetch fresh Torznab capabilities",
        "responses": {
          "400": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retry",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "502": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Fresh capabilities discovered; caps success does not prove search authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "connected",
                    "sourceRevision",
                    "capabilities",
                    "checkedAt"
                  ],
                  "properties": {
                    "connected": {
                      "type": "boolean",
                      "const": true
                    },
                    "sourceRevision": {
                      "type": "integer"
                    },
                    "capabilities": {
                      "$ref": "#/components/schemas/Capabilities"
                    },
                    "checkedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Sanitized diagnostic; no key, endpoint or upstream body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/releases": {
      "get": {
        "operationId": "searchMovieReleases",
        "summary": "Search source releases for a registered movie",
        "description": "Requires setup and tested source capabilities. Accepts no body. Candidate IDs are observations, not verified torrent identity or persisted selections. See REL-001\u2013REL-006 for evidence rules.",
        "parameters": [
          {
            "name": "movieId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "description": "Registered catalog identity."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            },
            "description": "Bounded provider pagination; limit is clamped to discovered maximum."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            },
            "description": "Bounded provider pagination; limit is clamped to discovered maximum."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "description": "Discovered category only; omitted means no category filter."
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh normalized observations and saved-profile explanations. No download URLs or credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleasePage"
                }
              }
            }
          },
          "400": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Sanitized failure. 409 includes missing capabilities, unsupported search, busy source, setup or revision change. 429 supplies Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "search",
          "movieSearch",
          "maxLimit",
          "defaultLimit",
          "categories"
        ],
        "properties": {
          "search": {
            "type": "object",
            "required": [
              "available",
              "supportedParams"
            ],
            "properties": {
              "available": {
                "type": "boolean"
              },
              "supportedParams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "movieSearch": {
            "type": "object",
            "required": [
              "available",
              "supportedParams"
            ],
            "properties": {
              "available": {
                "type": "boolean"
              },
              "supportedParams": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "maxLimit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "defaultLimit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "configured",
          "revision",
          "name",
          "url",
          "hasApiKey",
          "capabilities",
          "checkedAt"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "hasApiKey": {
            "type": "boolean"
          },
          "capabilities": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Capabilities"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ProfileCheck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "accepted"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "resolution",
              "format",
              "container",
              "audio"
            ]
          },
          "status": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "sizeBytes",
          "seeders",
          "publishedAt",
          "resolution",
          "format",
          "container",
          "audioLanguages",
          "preferredResolution",
          "audioPreferenceRank",
          "status",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "title": {
            "type": "string"
          },
          "sizeBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "seeders": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "container": {
            "type": [
              "string",
              "null"
            ]
          },
          "audioLanguages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferredResolution": {
            "type": "boolean"
          },
          "audioPreferenceRank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileCheck"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "ReleasePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "movieId",
          "sourceName",
          "sourceRevision",
          "profileRevision",
          "mode",
          "limit",
          "offset",
          "total",
          "hasMore",
          "items",
          "nextOffset"
        ],
        "properties": {
          "movieId": {
            "type": "integer",
            "minimum": 1
          },
          "sourceName": {
            "type": "string"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "profileRevision": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "enum": [
              "movie-tmdb",
              "movie-query",
              "search-query"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hasMore": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000,
            "description": "Offset after the raw provider items, including duplicates; null at end or offset bound."
          }
        }
      }
    }
  }
}
