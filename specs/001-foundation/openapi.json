{
  "openapi": "3.1.1",
  "info": {
    "title": "Piratarr Foundation API",
    "version": "0.1.0",
    "description": "Foundation API contract. All six operations are implemented. Localhost-only. Mutations require X-Piratarr-Request: 1 and same-origin browser requests. Settings writes are atomic, and PUT requires the current revision; stale updates return 409 without changing persisted values. Unknown API routes return structured 404; unsupported methods return structured 405 with Allow. Requests validate Host and browser Origin; no CORS permission headers are emitted."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
