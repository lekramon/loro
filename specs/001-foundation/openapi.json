    "/api/v1/directories": {
      "get": {
        "operationId": "listDirectories",
        "summary": "Browse existing directories on the server",
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of directories; nextOffset -1 means the last page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "path",
                    "parent",
                    "directories",
                    "nextOffset"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "parent": {
                      "type": "string"
                    },
                    "directories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "nextOffset": {
                      "type": "integer",
                      "minimum": -1
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "422": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "503": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/directories/defaults": {
      "post": {
        "operationId": "createDefaultDirectories",
        "summary": "Explicitly create and select default media folders",
        "parameters": [
          {
            "$ref": "#/components/parameters/MutationHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing or newly created default directories.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectorySettings"
                }
              }
            }
          },
          "400": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "403": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "413": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "415": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "422": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          },
          "503": {
            "description": "Directory operation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MutationHeader": {
        "in": "header",
        "name": "X-Piratarr-Request",
        "required": true,
        "schema": {
          "type": "string",
          "const": "1"
        },
        "description": "Required on every mutation; reject missing/incorrect values with 403."
      }
    },
    "schemas": {
      "Resolution": {
        "type": "string",
        "enum": [
          "480p",
          "576p",
          "720p",
          "1080p",
          "2160p"
        ]
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acceptedResolutions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Resolution"
            }
          },
          "preferredResolution": {
            "$ref": "#/components/schemas/Resolution"
          },
          "audioPreferences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(original|[a-z]{2})$"
            }
          },
          "acceptedFormats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "remux",
                "bluray",
                "web-dl",
                "webrip",
                "hdtv",
                "dvd"
              ]
            },
            "description": "Omitted on initial setup accepts all; omitted on update preserves saved values."
          },
          "acceptedContainers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "mkv",
                "mp4",
                "avi",
                "mov",
                "m4v",
                "ts"
              ]
            },
            "description": "Omitted on initial setup accepts all; omitted on update preserves saved values."
          }
        },
        "required": [
          "acceptedResolutions",
          "preferredResolution",
          "audioPreferences"
        ],
        "description": "Preferred resolution must be in acceptedResolutions. Audio tokens must be original or members of the bundled ISO 639-1 language list. Order is ranking. No defaults are selected."
      },
      "DirectorySettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "downloadDirectory": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute existing path in the application filesystem; returned canonicalized."
          },
          "movieDirectory": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute existing movie root; disjoint from download and application data roots."
          }
        },
        "required": [
          "downloadDirectory",
          "movieDirectory"
        ]
      },
      "SettingsInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "directories": {
            "$ref": "#/components/schemas/DirectorySettings"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "directories",
          "profile"
        ]
      },
      "SettingsUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "directories": {
            "$ref": "#/components/schemas/DirectorySettings"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "revision",
          "directories",
          "profile"
        ]
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "directories": {
            "$ref": "#/components/schemas/DirectorySettings"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "revision",
          "directories",
          "profile",
          "updatedAt"
        ]
      },
      "Language": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "SetupState": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "supportedResolutions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resolution"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Language"
            }
          }
        },
        "required": [
          "completed",
          "supportedResolutions",
          "languages"
        ]
      },
      "Live": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "alive"
          }
        },
        "required": [
          "status"
        ]
      },
      "Ready": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid-request",
              "unsupported-media-type",
              "request-too-large",
              "validation-failed",
              "setup-required",
              "setup-already-completed",
              "revision-conflict",
              "storage-unavailable",
              "not-ready",
              "forbidden",
              "not-found",
              "method-not-allowed",
              "internal-error"
            ]
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
