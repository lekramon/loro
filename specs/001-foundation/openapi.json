{
  "openapi": "3.1.1",
  "info": {
    "title": "Piratarr Foundation API",
    "version": "0.1.0",
    "description": "Foundation API contract. GET liveness, readiness, setup state and settings, plus POST setup, are implemented. PUT settings is specified for ticket 03 and currently unavailable. Localhost-only. Mutations require X-Piratarr-Request: 1 and same-origin browser requests. Setup writes are atomic. Unknown API routes return structured 404; unsupported methods return structured 405 with Allow. Requests validate Host and browser Origin; no CORS permission headers are emitted."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Initialization incomplete, storage unavailable, or shutting down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "operationId": "getSetup",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupState"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "completeSetup",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed, duplicate-key, trailing, or unknown-field JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Setup state or revision conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 65536 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Semantic validation failed; see fieldErrors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/MutationHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Setup required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceSettings",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "403": {
            "description": "Host, Origin, or mutation-header validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Malformed, duplicate-key, trailing, or unknown-field JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Setup state or revision conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 65536 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Semantic validation failed; see fieldErrors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/MutationHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MutationHeader": {
        "in": "header",
        "name": "X-Piratarr-Request",
        "required": true,
        "schema": {
          "type": "string",
          "const": "1"
        },
        "description": "Required on every mutation; reject missing/incorrect values with 403."
      }
    },
    "schemas": {
      "Resolution": {
        "type": "string",
        "enum": [
          "480p",
          "576p",
          "720p",
          "1080p",
          "2160p"
        ]
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "acceptedResolutions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Resolution"
            }
          },
          "preferredResolution": {
            "$ref": "#/components/schemas/Resolution"
          },
          "audioPreferences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(original|[a-z]{2})$"
            }
          }
        },
        "required": [
          "acceptedResolutions",
          "preferredResolution",
          "audioPreferences"
        ],
        "description": "Preferred resolution must be in acceptedResolutions. Audio tokens must be original or members of the bundled ISO 639-1 language list. Order is ranking. No defaults are selected."
      },
      "DirectorySettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "downloadDirectory": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute existing path in the application filesystem; returned canonicalized."
          },
          "movieDirectory": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute existing movie root; disjoint from download and application data roots."
          }
        },
        "required": [
          "downloadDirectory",
          "movieDirectory"
        ]
      },
      "SettingsInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "directories": {
            "$ref": "#/components/schemas/DirectorySettings"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "directories",
          "profile"
        ]
      },
      "SettingsUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "directories": {
            "$ref": "#/components/schemas/DirectorySettings"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "revision",
          "directories",
          "profile"
        ]
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "directories": {
            "$ref": "#/components/schemas/DirectorySettings"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "revision",
          "directories",
          "profile",
          "updatedAt"
        ]
      },
      "Language": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "SetupState": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "supportedResolutions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resolution"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Language"
            }
          }
        },
        "required": [
          "completed",
          "supportedResolutions",
          "languages"
        ]
      },
      "Live": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "alive"
          }
        },
        "required": [
          "status"
        ]
      },
      "Ready": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid-request",
              "unsupported-media-type",
              "request-too-large",
              "validation-failed",
              "setup-required",
              "setup-already-completed",
              "revision-conflict",
              "storage-unavailable",
              "not-ready",
              "forbidden",
              "not-found",
              "method-not-allowed",
              "internal-error"
            ]
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
