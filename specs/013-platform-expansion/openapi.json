{
  "openapi": "3.1.1",
  "info": {
    "title": "Lôro communication diagnostics API",
    "version": "0.1.0",
    "description": "Phase-zero platform expansion contract; future settings/media/subtitle APIs require separate amendments."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/system/communications": {
      "get": {
        "operationId": "listCommunicationEvents",
        "summary": "Read bounded sanitized application communication history",
        "description": "Read-only local diagnostics. No upstream request is made. With no after cursor return the newest matching window in chronological order. A cursor from another recorder session returns reset=true. A cursor older than retained history returns truncated=true. Viewer polling is not recorded. No raw URL, request/response body, credential, cookie, or private path is included.",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-f0-9]{16}:[0-9]+$"
            },
            "description": "Optional cursor returned by an earlier page."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "in": "query",
            "name": "integration",
            "schema": {
              "type": "string",
              "enum": [
                "api",
                "metadata",
                "source",
                "torrent",
                "download-client",
                "browser",
                "jobs",
                "system"
              ]
            }
          },
          {
            "in": "query",
            "name": "requestId",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chronological sanitized events, next cursor and persistence status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunicationPage"
                }
              }
            }
          },
          "400": {
            "description": "Unknown/duplicate query keys or a request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Host or Origin denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid limit, integration, cursor or correlation ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service stopping or diagnostics unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/acquisition-profiles": {
      "get": {"operationId":"listAcquisitionProfiles","responses":{"200":{"description":"Named acquisition profiles"}}},
      "post": {"operationId":"createAcquisitionProfile","parameters":[{"$ref":"#/components/parameters/MutationHeader"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AcquisitionProfileInput"}}}},"responses":{"201":{"description":"Created profile"},"400":{"description":"Invalid request"},"403":{"description":"Forbidden"},"413":{"description":"Request too large"},"415":{"description":"Unsupported media type"},"422":{"description":"Validation failed"},"503":{"description":"Storage unavailable"}}}
    },
    "/api/v1/acquisition-profiles/{id}": {
      "put": {"operationId":"updateAcquisitionProfile","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"integer","minimum":1}},{"$ref":"#/components/parameters/MutationHeader"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/AcquisitionProfileInput"},{"type":"object","required":["revision"],"properties":{"revision":{"type":"integer","minimum":1}}}]}}}},"responses":{"200":{"description":"Updated profile"},"409":{"description":"Revision conflict"},"400":{"description":"Invalid request"},"403":{"description":"Forbidden"},"413":{"description":"Request too large"},"415":{"description":"Unsupported media type"},"422":{"description":"Validation failed"},"503":{"description":"Storage unavailable"}}}
    },
    "/api/v1/quality-definitions": {
      "get": {"operationId":"listQualityDefinitions","responses":{"200":{"description":"Quality definitions"}}},
      "post": {"operationId":"createQualityDefinition","parameters":[{"$ref":"#/components/parameters/MutationHeader"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QualityDefinitionInput"}}}},"responses":{"201":{"description":"Created definition"},"400":{"description":"Invalid request"},"403":{"description":"Forbidden"},"413":{"description":"Request too large"},"415":{"description":"Unsupported media type"},"422":{"description":"Validation failed"},"503":{"description":"Storage unavailable"}}}
    },
    "/api/v1/custom-formats": {
      "get": {"operationId":"listCustomFormats","responses":{"200":{"description":"Custom formats"}}},
      "post": {"operationId":"createCustomFormat","parameters":[{"$ref":"#/components/parameters/MutationHeader"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomFormatInput"}}}},"responses":{"201":{"description":"Created custom format"},"400":{"description":"Invalid request"},"403":{"description":"Forbidden"},"413":{"description":"Request too large"},"415":{"description":"Unsupported media type"},"422":{"description":"Validation failed"},"503":{"description":"Storage unavailable"}}}
    },
    "/api/v1/catalog/movies/{id}/acquisition-profile": {
      "put": {"operationId":"assignMovieAcquisitionProfile","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"integer","minimum":1}},{"$ref":"#/components/parameters/MutationHeader"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["profileId"],"properties":{"profileId":{"type":"integer","minimum":1}}}}}},"responses":{"200":{"description":"Assignment saved"},"400":{"description":"Invalid request"},"403":{"description":"Forbidden"},"413":{"description":"Request too large"},"415":{"description":"Unsupported media type"},"422":{"description":"Validation failed"},"503":{"description":"Storage unavailable"}}}
    }
  },
  "components": {
    "parameters": {
      "MutationHeader": {"in":"header","name":"X-Piratarr-Request","required":true,"schema":{"type":"string","const":"1"}}
    },
    "schemas": {
      "AcquisitionProfileInput": {
        "type":"object","additionalProperties":false,"required":["name","acceptedResolutions","preferredResolution","acceptedFormats","acceptedContainers","audioPreferences","cutoffScore","allowUpgrades"],
        "properties":{"name":{"type":"string","minLength":1,"maxLength":100},"acceptedResolutions":{"type":"array","minItems":1,"items":{"type":"string","enum":["480p","576p","720p","1080p","2160p"]}},"preferredResolution":{"type":"string"},"acceptedFormats":{"type":"array","items":{"type":"string"}},"acceptedContainers":{"type":"array","items":{"type":"string"}},"audioPreferences":{"type":"array","items":{"type":"string"}},"cutoffScore":{"type":"integer","minimum":0,"maximum":10000},"allowUpgrades":{"type":"boolean"}}
      },
      "QualityDefinitionInput":{"type":"object","additionalProperties":false,"required":["name","resolution","source"],"properties":{"name":{"type":"string","minLength":1},"resolution":{"type":"string"},"source":{"type":"string"},"minSizePerMinute":{"type":["number","null"],"minimum":0},"preferredSizePerMinute":{"type":["number","null"],"minimum":0},"maxSizePerMinute":{"type":["number","null"],"minimum":0}}},
      "CustomFormatInput":{"type":"object","additionalProperties":false,"required":["name","predicates","score","minimumScore"],"properties":{"name":{"type":"string","minLength":1},"predicates":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["field","operator","value"],"properties":{"field":{"type":"string","enum":["resolution","source","format","container","audio","codec","hdr"]},"operator":{"type":"string","enum":["equals","contains"]},"value":{"type":"string"}}}},"score":{"type":"integer","minimum":-10000,"maximum":10000},"minimumScore":{"type":"integer","minimum":-10000,"maximum":10000}}},
      "CommunicationEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "timestamp",
          "requestId",
          "integration",
          "operation",
          "phase",
          "level",
          "status",
          "elapsedMs",
          "retryAfterSeconds",
          "code",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "integration": {
            "type": "string",
            "enum": [
              "api",
              "metadata",
              "source",
              "torrent",
              "download-client",
              "browser",
              "jobs",
              "system"
            ]
          },
          "operation": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "phase": {
            "type": "string",
            "enum": [
              "request.started",
              "response.received",
              "request.failed",
              "operation.started",
              "operation.completed",
              "operation.failed",
              "browser.started",
              "browser.navigation",
              "browser.response",
              "browser.challenge.detected",
              "browser.widget.found",
              "browser.interaction",
              "browser.challenge.cleared",
              "browser.parsed",
              "browser.stopped",
              "browser.failed",
              "storage.degraded"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "elapsedMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retryAfterSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3600
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "CommunicationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "entries",
          "cursor",
          "reset",
          "truncated",
          "storageAvailable"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "entries": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/CommunicationEvent"
            }
          },
          "cursor": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}:[0-9]+$"
          },
          "reset": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "storageAvailable": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
