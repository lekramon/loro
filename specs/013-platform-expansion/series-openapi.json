{
  "openapi": "3.1.1",
  "info": {"title": "Lôro series and episode API", "version": "0.1.0"},
  "servers": [{"url": "http://localhost:8080"}],
  "paths": {
    "/api/v1/series": {
      "get": {"operationId": "listSeries", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Anime"}], "responses": {"200": {"description": "Series catalog page"}}},
      "post": {"operationId": "createSeries", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SeriesInput"}}}}, "responses": {"201": {"description": "Series created"}, "409": {"description": "Stale or duplicate identity"}}}
    },
    "/api/v1/series/{seriesId}": {
      "get": {"operationId": "getSeries", "parameters": [{"$ref": "#/components/parameters/SeriesId"}], "responses": {"200": {"description": "Series detail"}, "404": {"description": "Series not found"}}}
    },
    "/api/v1/series/{seriesId}/seasons": {
      "get": {"operationId": "listSeasons", "parameters": [{"$ref": "#/components/parameters/SeriesId"}], "responses": {"200": {"description": "Season list"}}}
    },
    "/api/v1/episodes/{episodeId}": {
      "get": {"operationId": "getEpisode", "parameters": [{"$ref": "#/components/parameters/EpisodeId"}], "responses": {"200": {"description": "Episode detail"}, "404": {"description": "Episode not found"}}}
    },
    "/api/v1/series/{seriesId}/episodes": {
      "get": {"operationId": "listEpisodes", "parameters": [{"$ref": "#/components/parameters/SeriesId"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Offset"}, {"$ref": "#/components/parameters/Season"}], "responses": {"200": {"description": "Episode page"}}}
    },
    "/api/v1/episodes/search": {
      "post": {"operationId": "searchEpisodes", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EpisodeSearch"}}}}, "responses": {"200": {"description": "Manual episode candidates"}, "422": {"description": "Invalid numbering or identity"}}}
    }
  },
  "components": {
    "parameters": {
      "SeriesId": {"name": "seriesId", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
      "EpisodeId": {"name": "episodeId", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}},
      "Offset": {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
      "Anime": {"name": "anime", "in": "query", "schema": {"type": "boolean"}},
      "Season": {"name": "season", "in": "query", "schema": {"type": "integer", "minimum": 0}}
    },
    "schemas": {
      "SeriesInput": {"type": "object", "additionalProperties": false, "required": ["title", "providerId"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 300}, "provider": {"type": "string", "enum": ["tmdb"]}, "providerId": {"type": "integer", "minimum": 1}, "anime": {"type": "boolean"}}},
      "EpisodeSearch": {"type": "object", "additionalProperties": false, "required": ["episodeId", "query"], "properties": {"episodeId": {"type": "integer", "minimum": 1}, "query": {"type": "string", "minLength": 1, "maxLength": 200}, "seasonNumber": {"type": "integer", "minimum": 0}, "episodeNumber": {"type": "integer", "minimum": 1}, "absoluteNumber": {"type": "integer", "minimum": 1}}}
    }
  }
}
