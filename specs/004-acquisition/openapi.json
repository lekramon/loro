    "/api/v1/download-client/test": {
      "post": {
        "operationId": "testDownloadClient",
        "summary": "Authenticate with qBittorrent and verify supported versions",
        "description": "Explicit test only. Fresh private session, best-effort logout, no retries or torrent mutations. Does not verify submission or path mapping.",
        "parameters": [
          {
            "name": "X-Piratarr-Request",
            "in": "header",
            "required": true,
            "schema": {
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Public configuration or fresh connection evidence. Password and SID omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionTest"
                }
              }
            }
          },
          "400": {
