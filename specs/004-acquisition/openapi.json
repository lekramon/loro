                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveDownloadClient",
        "summary": "Save qBittorrent base URL and private password",
        "parameters": [
          {
            "name": "X-Piratarr-Request",
            "in": "header",
            "required": true,
            "schema": {
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Public configuration or fresh connection evidence. Password and SID omitted.",
