    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "DownloadClient": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "hasPassword": {
            "type": "boolean"
          },
          "appVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "apiVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "configured",
          "revision",
          "url",
          "username",
          "hasPassword",
          "appVersion",
          "apiVersion",
          "checkedAt"
        ]
      },
      "ConnectionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "writeOnly": true,
            "description": "UTF-8 byte bound; blank or omitted preserves only when URL and username are unchanged. Initial save requires a password."
          }
        },
        "required": [
          "revision",
          "url",
          "username"
        ]
      },
      "ConnectionTest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connected": {
            "const": true
          },
          "clientRevision": {
            "type": "integer",
            "minimum": 1
          },
          "appVersion": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "connected",
          "clientRevision",
          "appVersion",
          "apiVersion",
          "checkedAt"
        ]
      }
    }
  }
}
