        "operationId": "getDownloadClient",
        "summary": "Read public qBittorrent configuration",
        "responses": {
          "200": {
            "description": "Public configuration or fresh connection evidence. Password and SID omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadClient"
                }
              }
            }
          },
          "400": {
            "description": "Sanitized failure. See DCL-001\u2013DCL-006 for error codes. 429 includes bounded Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sanitized failure. See DCL-001\u2013DCL-006 for error codes. 429 includes bounded Retry-After.",
