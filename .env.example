# Lôro retains these Compose variable names for deployment compatibility.
# Linux Docker Compose paths. Create and assign ownership before starting.
# Keep these outside the repository and synchronized folders.
PIRATARR_CONFIG_DIR=/srv/piratarr/config
PIRATARR_STORAGE_DIR=/srv/piratarr/data
PIRATARR_UID=10001
PIRATARR_GID=10001
PIRATARR_WORKERS=4
PIRATARR_PORT=8080
